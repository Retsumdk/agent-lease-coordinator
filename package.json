{
  "name": "agent-lease-coordinator",
  "description": "Lease-based coordination library for reserving shared tools and preventing conflicting agent operations",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "agent",
    "lease",
    "coordination",
    "mutual-exclusion",
    "distributed-lock",
    "ttl",
    "ai-agents",
    "concurrency"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Retsumdk/agent-lease-coordinator.git"
  },
  "bin": {
    "agent-lease-coordinator": "./src/index.ts"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "bun": ">=1.0.0"
  },
  "scripts": {
    "start": "bun run src/index.ts",
    "test": "bun test",
    "build": "tsc",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "commander": "^11.1.0"
  },
  "devDependencies": {
    "bun-types": "^1.0.0",
    "typescript": "^5.3.0"
  }
}
